{
  "info": {
    "name": "SmartClean Frontend-Compatible Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "citizen_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "complaint_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Register Citizen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Om Prakash Panda\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"example@gmail.com\"\n}"
        },
        "url": "{{base_url}}/auth/register"
      }
    },
    {
      "name": "Citizen Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
        },
        "url": "{{base_url}}/auth/verify-otp"
      }
    },
    {
      "name": "Create Complaint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{citizen_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Garbage Dump\",\n  \"description\": \"Large garbage dump near Gate 3\",\n  \"location\": \"Gate 3\",\n  \"latitude\": 20.2961,\n  \"longitude\": 85.8245,\n  \"priority\": \"High\"\n}"
        },
        "url": "{{base_url}}/complaints"
      }
    },
    {
      "name": "Citizen Complaint List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{citizen_token}}"
          }
        ],
        "url": "{{base_url}}/complaints"
      }
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"YOUR_ADMIN_EMAIL\",\n  \"password\": \"YOUR_ADMIN_PASSWORD\"\n}"
        },
        "url": "{{base_url}}/auth/admin-login"
      }
    },
    {
      "name": "Admin Complaint List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/admin/complaints"
      }
    },
    {
      "name": "Admin Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/admin/dashboard"
      }
    },
    {
      "name": "Update Complaint Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\",\n  \"assignedTo\": \"Sanitation Team A\"\n}"
        },
        "url": "{{base_url}}/admin/complaints/{{complaint_id}}/status"
      }
    }
  ]
}
